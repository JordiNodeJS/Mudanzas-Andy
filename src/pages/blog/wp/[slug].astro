---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getUnifiedWordPressPosts } from "@/lib/utils/wordpress";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  // Obtener todos los posts de WordPress
  const { posts } = await getUnifiedWordPressPosts({
    perPage: 100,
  });

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;

// Obtener el contenido completo del post desde WordPress
const fetchPostContent = async () => {
  try {
    const response = await fetch(
      `https://barcelona.mudanzasandy.es/wp-json/wp/v2/posts?slug=${post.slug}&_embed=true`
    );
    const data = await response.json();
    return data[0];
  } catch (error) {
    console.error("Error fetching post content:", error);
    return null;
  }
};

const fullPost = await fetchPostContent();
const content = fullPost?.content?.rendered || "";

const SITE_CANONICAL = "https://mudanzasandy.es";
---

<Layout
  title={`${post.title} | Blog Mudanzas ANDY`}
  description={post.description}
  image={post.heroImage}
  canonical={`${SITE_CANONICAL}/blog/wp/${post.slug}`}
>
  <Header />

  <main class="pt-20 md:pt-24 lg:pt-28">
    <!-- Hero del artículo -->
    <section class="py-20 bg-gradient-to-br from-[rgb(var(--color-primary))] via-[rgb(var(--color-secondary))] to-[rgb(var(--color-neutral))]">
      <div class="container mx-auto px-4">
        <!-- Breadcrumb -->
        <nav class="text-white/80 text-sm mb-8">
          <a href="/" class="hover:text-white">Inicio</a>
          <span class="mx-2">/</span>
          <a href="/blog-astro" class="hover:text-white">Blog</a>
          <span class="mx-2">/</span>
          <span class="text-white">{post.title}</span>
        </nav>

        <div class="max-w-4xl mx-auto text-center text-white">
          <!-- Badge de categoría -->
          {post.category && (
            <span class="inline-block bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full text-sm font-semibold mb-6">
              {post.category}
            </span>
          )}

          <!-- Título -->
          <h1 class="text-3xl lg:text-5xl font-bold mb-6">{post.title}</h1>

          <!-- Meta información -->
          <div class="flex items-center justify-center gap-6 text-sm text-white/80 mb-8">
            <time datetime={post.pubDate.toISOString()}>
              {post.pubDate.toLocaleDateString("es-ES", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            {post.author && (
              <>
                <span>•</span>
                <span>{post.author}</span>
              </>
            )}
          </div>

          <!-- Imagen destacada -->
          {post.heroImage && (
            <img
              src={post.heroImage}
              alt={post.heroImageAlt || post.title}
              class="w-full max-w-3xl mx-auto rounded-2xl shadow-2xl"
              loading="eager"
            />
          )}
        </div>
      </div>
    </section>

    <!-- Contenido del artículo -->
    <article class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <!-- Contenido HTML desde WordPress -->
          <div 
            class="wp-content prose prose-lg max-w-none"
            set:html={content}
          />

          <!-- Tags -->
          {post.tags && post.tags.length > 0 && (
            <div class="mt-12 pt-8 border-t border-gray-200">
              <h3 class="text-lg font-semibold mb-4">Etiquetas:</h3>
              <div class="flex flex-wrap gap-2">
                {post.tags.map((tag) => (
                  <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Botones de compartir y volver -->
          <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-between items-center">
            <a
              href="/blog-astro"
              class="btn btn-outline-primary inline-flex items-center gap-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-5 h-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"
                />
              </svg>
              Volver al Blog
            </a>

            <div class="flex gap-2">
              <span class="text-sm text-gray-600">Artículo original:</span>
              <a
                href={post.externalLink}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-[rgb(var(--color-primary))] hover:underline"
              >
                Ver en WordPress
              </a>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- CTA Section -->
    <section class="bg-gradient-to-br from-[rgb(var(--color-primary))] to-[rgb(var(--color-secondary))] text-white py-16">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">
          ¿Necesitas una mudanza profesional en Barcelona?
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Nuestro equipo de expertos está listo para hacer de tu mudanza una
          experiencia fácil y sin estrés.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="/contacto"
            class="btn btn-accent inline-flex items-center gap-2 px-8 py-4 text-lg font-semibold"
          >
            📞 Solicitar Presupuesto Gratis
          </a>
          <a
            href="tel:+34933539792"
            class="btn btn-outline-white inline-flex items-center gap-2 px-8 py-4 text-lg font-semibold"
          >
            ☎️ Llamar Ahora
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Estilos para el contenido de WordPress */
  .wp-content {
    color: #374151;
    line-height: 1.75;
  }

  /* Headings */
  .wp-content :global(h1),
  .wp-content :global(h2),
  .wp-content :global(h3),
  .wp-content :global(h4),
  .wp-content :global(h5),
  .wp-content :global(h6) {
    font-weight: 700;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .wp-content :global(h1) {
    font-size: 2.25rem;
  }

  .wp-content :global(h2) {
    font-size: 1.875rem;
  }

  .wp-content :global(h3) {
    font-size: 1.5rem;
  }

  .wp-content :global(h4) {
    font-size: 1.25rem;
  }

  /* Párrafos */
  .wp-content :global(p) {
    margin-bottom: 1.25rem;
    color: #4b5563;
  }

  /* Listas */
  .wp-content :global(ul),
  .wp-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .wp-content :global(ul) {
    list-style-type: disc;
  }

  .wp-content :global(ol) {
    list-style-type: decimal;
  }

  .wp-content :global(li) {
    margin-bottom: 0.5rem;
    color: #4b5563;
  }

  /* Enlaces */
  .wp-content :global(a) {
    color: rgb(var(--color-primary));
    text-decoration: none;
  }

  .wp-content :global(a:hover) {
    text-decoration: underline;
  }

  /* Strong/Bold */
  .wp-content :global(strong) {
    font-weight: 700;
    color: #111827;
  }

  /* Énfasis */
  .wp-content :global(em) {
    font-style: italic;
  }

  /* Imágenes */
  .wp-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    margin: 2rem auto;
  }

  /* Código */
  .wp-content :global(code) {
    background-color: #f3f4f6;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: monospace;
  }

  .wp-content :global(pre) {
    background-color: #f3f4f6;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .wp-content :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  /* Blockquotes */
  .wp-content :global(blockquote) {
    border-left: 4px solid rgb(var(--color-primary));
    padding-left: 1rem;
    font-style: italic;
    color: #4b5563;
    margin: 1.5rem 0;
  }

  /* Tablas */
  .wp-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
  }

  .wp-content :global(th),
  .wp-content :global(td) {
    padding: 0.75rem;
    border: 1px solid #e5e7eb;
    text-align: left;
  }

  .wp-content :global(th) {
    background-color: #f9fafb;
    font-weight: 700;
  }

  /* Separadores */
  .wp-content :global(hr) {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2rem 0;
  }
</style>

