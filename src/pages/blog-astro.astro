---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

// Importar componente híbrido de blog en tiempo real
import LiveBlogGrid from "../components/LiveBlogGrid";

// Importar componentes del blog (para paginación)
import Pagination from "../layouts/components/blog/Pagination.astro";

// Importar utilidades de WordPress
import { getUnifiedWordPressPosts } from "@/lib/utils/wordpress.js";
import type { UnifiedBlogPost } from "@/lib/types/wordpress.js";
import type { CollectionEntry } from "astro:content";

// Configuración de paginación
const POSTS_PER_PAGE = 9;
const currentPage = parseInt(Astro.url.searchParams.get("page") || "1");

// Obtener posts de WordPress en build time (para SEO y fallback)
const wpResponse = await getUnifiedWordPressPosts({
  perPage: 100,
  orderBy: "date",
  order: "desc",
});

// Obtener todos los posts de Astro
const allAstroPosts = await getCollection("blog");

// Filtrar posts de Astro publicados (no draft) y ordenar por fecha
const publishedAstroPosts = allAstroPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Combinar posts para calcular totalPages (necesario para paginación)
const allUnifiedPosts: (CollectionEntry<"blog"> | UnifiedBlogPost)[] = [
  ...wpResponse.posts,
  ...publishedAstroPosts,
];

// Ordenar todos los posts por fecha
const sortedPosts = allUnifiedPosts.sort((a, b) => {
  const dateA = "data" in a ? a.data.pubDate : a.pubDate;
  const dateB = "data" in b ? b.data.pubDate : b.pubDate;
  return dateB.valueOf() - dateA.valueOf();
});

// Calcular total de páginas (excluyendo el primer post que va como hero en página 1)
const remainingPosts = sortedPosts.slice(1);
const totalPages = Math.ceil(remainingPosts.length / POSTS_PER_PAGE);

const pageTitle =
  currentPage === 1
    ? "Blog Mudanzas Barcelona - Consejos Económicos y Baratos | Mudanzas ANDY"
    : `Blog Mudanzas Barcelona - Página ${currentPage} | Mudanzas ANDY`;
const pageDescription =
  "➤ Blog de mudanzas en Barcelona con consejos económicos y baratos. Guías profesionales para mudanzas económicas, tips para ahorrar, embalaje barato y traslados en toda la península. ¡Mudanzas ANDY - Calidad al mejor precio!";
// Canonical used in JSON-LD
const SITE_CANONICAL = "https://mudanzasandy.es";

// Construir canonical URL con paginación
const canonicalUrl =
  currentPage === 1
    ? `${SITE_CANONICAL}/blog-astro/`
    : `${SITE_CANONICAL}/blog-astro/?page=${currentPage}`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/logos/logo-mudanzas-andy.svg"
  canonical={canonicalUrl}
  keywords="mudanzas barcelona, mudanzas económicas, mudanzas baratas, mudanzas peninsula, consejos mudanza, embalaje barato, traslados económicos, mudanza económica barcelona, presupuesto mudanza barato, mudanzas profesionales"
>
  <!-- Header fijo -->
  <Header />

  <main data-astro-transition-scope="blog" class="pt-20 lg:pt-24">
    <!-- Componente híbrido con actualización en tiempo real -->
    <!-- NOTA: Ya NO pasamos initialWordPressPosts para evitar el efecto de "parpadeo"
         cuando hay posts en borrador. El componente siempre inicia con loading y 
         obtiene datos frescos directamente desde WordPress. -->
    <LiveBlogGrid
      client:load
      astroPosts={publishedAstroPosts}
      currentPage={currentPage}
      postsPerPage={POSTS_PER_PAGE}
      showHero={true}
    />

    <!-- Componente de paginación -->
    {totalPages > 1 && (
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl="/blog-astro"
      />
    )}

    <!-- Sección de CTA -->
    <section
      class="bg-gradient-to-br from-[rgb(var(--color-primary))] to-[rgb(var(--color-secondary))] text-white py-16"
    >
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">
          ¿Necesitas una mudanza profesional en Barcelona?
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto">
          Nuestro equipo de expertos está listo para hacer de tu mudanza una
          experiencia fácil y sin estrés.
        </p>
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center items-center"
        >
          <a
            href="/contacto"
            class="btn btn-accent inline-flex items-center gap-2 px-8 py-4 text-lg font-semibold"
          >
            📞 Solicitar Presupuesto Gratis
          </a>
          <a
            href="tel:+34930000000"
            class="btn btn-outline-white inline-flex items-center gap-2 px-8 py-4 text-lg font-semibold"
          >
            ☎️ Llamar Ahora
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <Footer />

  <!-- Structured Data for SEO -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      name: "Blog de Mudanzas ANDY",
      description:
        "Blog especializado en consejos, guías y artículos sobre mudanzas profesionales en Barcelona y toda la península. Tips para mudanzas económicas y baratas.",
      url: `${SITE_CANONICAL}/blog-astro/`,
      publisher: {
        "@type": "Organization",
        name: "Mudanzas ANDY",
        logo: {
          "@type": "ImageObject",
          url: `${SITE_CANONICAL}/logos/logo-mudanzas-andy.svg`,
        },
        url: SITE_CANONICAL,
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalUrl,
      },
      blogPost: sortedPosts.slice(0, 5).map((post) => {
        const isAstroPost = "collection" in post;
        const postData = isAstroPost ? post.data : post;
        const postUrl = isAstroPost 
          ? `${SITE_CANONICAL}/blog/${post.id}` 
          : (post as UnifiedBlogPost).externalLink || (post as UnifiedBlogPost).postUrl;
        
        return {
          "@type": "BlogPosting",
          headline: postData.title,
          description: postData.description,
          url: postUrl,
          datePublished: postData.pubDate.toISOString(),
          author: {
            "@type": "Person",
            name: postData.author || "Equipo Mudanzas ANDY",
          },
          publisher: {
            "@type": "Organization",
            name: "Mudanzas ANDY",
          },
        };
      }),
      keywords:
        "mudanzas barcelona, mudanzas económicas, mudanzas baratas, consejos mudanza, embalaje barato, traslados económicos, blog mudanzas",
      about: [
        { "@type": "Thing", name: "Mudanzas Barcelona" },
        { "@type": "Thing", name: "Mudanzas Económicas" },
        { "@type": "Thing", name: "Consejos de Mudanza" },
      ],
    })}
  />
</Layout>

    })}
  />
</Layout>

<style is:global>
  /* Utility para limitar líneas de texto */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
