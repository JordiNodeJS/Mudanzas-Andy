---
/**
 * Blog Híbrido - WordPress en Tiempo Real + Contenido Estático
 * 
 * Esta página implementa un sistema híbrido que:
 * 1. Genera HTML estático en build time para SEO
 * 2. Actualiza los posts de WordPress en tiempo real desde el navegador
 * 3. Muestra contenido estático como fallback si WordPress no está disponible
 * 
 * Compatible con hosting estático (Hostinger)
 */

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LiveWordPressPosts from "../components/LiveWordPressPosts";
import { getCollection } from "astro:content";
import { getUnifiedWordPressPosts } from "@/lib/utils/wordpress.js";

// ===== BUILD TIME: Generar contenido estático para SEO =====

// Obtener posts de WordPress en build time (para SEO y fallback)
const wpResponse = await getUnifiedWordPressPosts({
  perPage: 20,
  orderBy: "date",
  order: "desc",
});

// Obtener posts de Astro locales
const allAstroPosts = await getCollection("blog");
const publishedAstroPosts = allAstroPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// SEO
const pageTitle = "Blog en Tiempo Real - Mudanzas Barcelona | Mudanzas ANDY";
const pageDescription =
  "Blog actualizado en tiempo real con consejos de mudanzas en Barcelona, guías profesionales y tips para mudanzas económicas. Contenido fresco desde WordPress.";
const SITE_CANONICAL = "https://mudanzasandy.es";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/logos/logo-mudanzas-andy.svg"
  canonical={`${SITE_CANONICAL}/blog-live/`}
>
  <Header />

  <main class="pt-20 md:pt-24 lg:pt-28">
    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-br from-[rgb(var(--color-primary))] via-[rgb(var(--color-secondary))] to-[rgb(var(--color-neutral))]">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center text-white">
          <h1 class="text-4xl lg:text-6xl font-bold mb-6">
            Blog en Tiempo Real
          </h1>
          <p class="text-xl lg:text-2xl text-white/90 mb-8">
            Contenido fresco y actualizado de WordPress
          </p>
          <div class="flex items-center justify-center gap-4 text-sm">
            <div class="flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full">
              <span class="inline-block w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
              <span>Actualizaciones en vivo</span>
            </div>
            <div class="bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full">
              Contenido dinámico
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Posts de WordPress en Vivo -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-7xl mx-auto">
          <!-- Título de la sección -->
          <div class="mb-12 text-center">
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
              Últimas Publicaciones desde WordPress
            </h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              Estos posts se actualizan automáticamente cuando se publican en WordPress.
              No necesitas esperar a un rebuild del sitio.
            </p>
          </div>

          <!-- Componente React con posts en vivo -->
          <!-- client:load = Hidrata inmediatamente para cargar datos frescos -->
          <LiveWordPressPosts 
            client:load
            postsPerPage={12}
            autoRefresh={false}
            showLoading={true}
            className="mb-12"
          />

          <!-- Información técnica -->
          <div class="mt-12 p-6 bg-blue-50 border-l-4 border-[rgb(var(--color-primary))] rounded-lg">
            <div class="flex items-start">
              <svg class="w-6 h-6 text-[rgb(var(--color-primary))] mt-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  ¿Cómo funciona este sistema?
                </h3>
                <div class="text-gray-700 space-y-2">
                  <p>
                    <strong>🔄 Actualización en tiempo real:</strong> Los posts se cargan directamente desde WordPress cuando visitas esta página.
                  </p>
                  <p>
                    <strong>📱 Compatible con hosting estático:</strong> Funciona perfectamente en Hostinger sin necesidad de servidor dinámico.
                  </p>
                  <p>
                    <strong>🚀 Mejor SEO:</strong> El contenido estático se genera en build time, pero se actualiza en el navegador.
                  </p>
                  <p>
                    <strong>💾 Fallback inteligente:</strong> Si WordPress no está disponible, se muestra el contenido en caché.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Posts de Astro Locales (Contenido Estático) -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-7xl mx-auto">
          <div class="mb-12 text-center">
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
              Posts Locales de Astro
            </h2>
            <p class="text-lg text-gray-600">
              Contenido estático generado en build time
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {publishedAstroPosts.slice(0, 6).map((post) => (
              <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300">
                {post.data.heroImage && (
                  <a href={`/blog/${post.id}`}>
                    <img
                      src={post.data.heroImage.src}
                      alt={post.data.heroImageAlt || post.data.title}
                      class="w-full h-48 object-cover"
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-3">
                    <a
                      href={`/blog/${post.id}`}
                      class="text-gray-900 hover:text-[rgb(var(--color-primary))] transition-colors"
                    >
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="text-gray-600 mb-4">
                    {post.data.description}
                  </p>
                  <div class="flex items-center justify-between text-sm text-gray-500">
                    <span>{post.data.pubDate.toLocaleDateString('es-ES')}</span>
                    <span>{post.data.author}</span>
                  </div>
                  <div class="mt-4 pt-4 border-t border-gray-200">
                    <span class="inline-flex items-center text-xs text-gray-500">
                      <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                      </svg>
                      Contenido Astro
                    </span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-r from-[rgb(var(--color-primary))] to-[rgb(var(--color-secondary))]">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center text-white">
          <h2 class="text-3xl lg:text-4xl font-bold mb-6">
            ¿Necesitas una mudanza en Barcelona?
          </h2>
          <p class="text-xl mb-8">
            Obtén un presupuesto gratuito sin compromiso
          </p>
          <a
            href="/contacto"
            class="inline-block bg-white text-[rgb(var(--color-primary))] px-8 py-4 rounded-lg font-semibold text-lg hover:bg-gray-100 transition-colors shadow-lg"
          >
            Solicitar Presupuesto
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Estilos adicionales si son necesarios */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
