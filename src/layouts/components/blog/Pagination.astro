---
/**
 * Componente de paginación para el blog
 * Muestra controles de navegación entre páginas
 */

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: string;
}

const { currentPage, totalPages, baseUrl = "/blog-astro" } = Astro.props satisfies Props;

// Generar array de números de página a mostrar
const generatePageNumbers = (): (number | string)[] => {
  const pages: (number | string)[] = [];
  const maxVisiblePages = 7;

  if (totalPages <= maxVisiblePages) {
    // Mostrar todas las páginas
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    // Siempre mostrar primera página
    pages.push(1);

    if (currentPage > 3) {
      pages.push("...");
    }

    // Páginas alrededor de la actual
    const start = Math.max(2, currentPage - 1);
    const end = Math.min(totalPages - 1, currentPage + 1);

    for (let i = start; i <= end; i++) {
      pages.push(i);
    }

    if (currentPage < totalPages - 2) {
      pages.push("...");
    }

    // Siempre mostrar última página
    pages.push(totalPages);
  }

  return pages;
};

const pageNumbers = generatePageNumbers();

// Función para generar URL de página
const getPageUrl = (page: number): string => {
  if (page === 1) {
    return baseUrl;
  }
  return `${baseUrl}?page=${page}`;
};

const hasPrevPage = currentPage > 1;
const hasNextPage = currentPage < totalPages;
---

<nav class="pagination-container" aria-label="Navegación de páginas del blog">
  <div class="container">
    <div class="flex justify-center items-center gap-2 flex-wrap">
      <!-- Botón Anterior -->
      {hasPrevPage ? (
        <a
          href={getPageUrl(currentPage - 1)}
          class="pagination-button pagination-button-nav"
          aria-label="Página anterior"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-5 h-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 19.5L8.25 12l7.5-7.5"
            />
          </svg>
          <span class="hidden sm:inline">Anterior</span>
        </a>
      ) : (
        <button
          class="pagination-button pagination-button-nav pagination-button-disabled"
          disabled
          aria-label="Página anterior (deshabilitado)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-5 h-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 19.5L8.25 12l7.5-7.5"
            />
          </svg>
          <span class="hidden sm:inline">Anterior</span>
        </button>
      )}

      <!-- Números de página -->
      {pageNumbers.map((page) => {
        if (page === "...") {
          return (
            <span class="pagination-ellipsis" aria-hidden="true">
              ...
            </span>
          );
        }

        const pageNum = page as number;
        const isActive = pageNum === currentPage;

        return isActive ? (
          <span
            class="pagination-button pagination-button-active"
            aria-current="page"
            aria-label={`Página ${pageNum} (actual)`}
          >
            {pageNum}
          </span>
        ) : (
          <a
            href={getPageUrl(pageNum)}
            class="pagination-button"
            aria-label={`Ir a página ${pageNum}`}
          >
            {pageNum}
          </a>
        );
      })}

      <!-- Botón Siguiente -->
      {hasNextPage ? (
        <a
          href={getPageUrl(currentPage + 1)}
          class="pagination-button pagination-button-nav"
          aria-label="Página siguiente"
        >
          <span class="hidden sm:inline">Siguiente</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-5 h-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 4.5l7.5 7.5-7.5 7.5"
            />
          </svg>
        </a>
      ) : (
        <button
          class="pagination-button pagination-button-nav pagination-button-disabled"
          disabled
          aria-label="Página siguiente (deshabilitado)"
        >
          <span class="hidden sm:inline">Siguiente</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-5 h-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 4.5l7.5 7.5-7.5 7.5"
            />
          </svg>
        </button>
      )}
    </div>

    <!-- Información de página actual -->
    <div class="text-center mt-4 text-sm text-gray-600">
      Página <strong>{currentPage}</strong> de <strong>{totalPages}</strong>
    </div>
  </div>
</nav>

<style>
  .pagination-container {
    padding-top: 3rem;
    padding-bottom: 3rem;
    background: linear-gradient(to bottom, white, rgb(249 250 251));
  }

  .pagination-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: rgb(55 65 81);
    background-color: white;
    border: 1px solid rgb(209 213 219);
    border-radius: 0.5rem;
    transition: all 0.2s;
  }

  .pagination-button:hover {
    background-color: rgb(var(--color-primary));
    color: white;
    border-color: rgb(var(--color-primary));
  }

  .pagination-button:focus {
    outline: 2px solid transparent;
    outline-offset: 2px;
    box-shadow: 0 0 0 2px rgb(var(--color-primary) / 0.5);
  }

  .pagination-button-nav {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .pagination-button-active {
    background-color: rgb(var(--color-primary));
    color: white;
    border-color: rgb(var(--color-primary));
    cursor: default;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  }

  .pagination-button-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pagination-button-disabled:hover {
    background-color: white;
    color: rgb(55 65 81);
    border-color: rgb(209 213 219);
  }

  .pagination-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    color: rgb(107 114 128);
    font-weight: 500;
  }
</style>
