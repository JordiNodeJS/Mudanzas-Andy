---
/**
 * Componente de tarjeta de post de WordPress
 * Similar a BlogPostCard pero adaptado para posts externos de WordPress
 */

import type { UnifiedBlogPost } from "@/lib/types/wordpress";

interface Props {
  post: UnifiedBlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props satisfies Props;

// Función para formatear fecha
const formatDate = (date: Date): string => {
  return date.toLocaleDateString("es-ES", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Función para generar excerpt del contenido
const generateExcerpt = (
  description: string,
  maxLength: number = 150
): string => {
  if (description.length <= maxLength) return description;
  return description.substring(0, maxLength).trim() + "...";
};

// Para posts de WordPress, usar el link externo
const postUrl = post.externalLink || post.postUrl;
const isExternal = post.source === "wordpress";
---

<article
  class={`blog-post-card wordpress-post-card bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden group ${
    featured ? "lg:col-span-2" : ""
  }`}
>
  <!-- Imagen hero del post -->
  {
    post.heroImage && (
      <div class="relative overflow-hidden">
        <img
          src={post.heroImage}
          alt={post.heroImageAlt || post.title}
          width={featured ? 800 : 400}
          height={featured ? 400 : 250}
          class="w-full h-48 md:h-56 object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />

        <!-- Badge de categoría -->
        <div class="absolute top-4 left-4 flex gap-2">
          <span class="badge-gradient-primary px-3 py-1 text-xs font-semibold text-white rounded-full">
            {post.category || "General"}
          </span>
          {/* Badge indicador de WordPress */}
          <span class="bg-blue-600 px-3 py-1 text-xs font-semibold text-white rounded-full flex items-center gap-1">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-3 h-3"
            >
              <path d="M12.5 2C6.977 2 2.5 6.477 2.5 12s4.477 10 10 10 10-4.477 10-10-4.477-10-10-10zm-.5 2.014V12.5l-4.23 2.445a8 8 0 01-.77-3.445c0-2.86 1.5-5.37 3.75-6.79.41-.21.85-.39 1.25-.53V4.014zm1 0c.4.14.84.32 1.25.53 2.25 1.42 3.75 3.93 3.75 6.79 0 1.23-.28 2.39-.77 3.445L13 12.5V4.014zm-5.765 12.25L12 18.708l4.765-2.444A8 8 0 0112.5 20a8 8 0 01-5.265-3.736z" />
            </svg>
            WordPress
          </span>
        </div>

        {/* Badge de destacado */}
        {post.featured && (
          <div class="absolute top-4 right-4">
            <span class="bg-[rgb(var(--color-accent))] px-3 py-1 text-xs font-semibold text-gray-900 rounded-full">
              Destacado
            </span>
          </div>
        )}
      </div>
    )
  }

  <!-- Contenido de la tarjeta -->
  <div class="p-6">
    <!-- Metadatos del post -->
    <div class="flex items-center gap-4 text-sm text-gray-600 mb-3">
      <!-- Fecha de publicación -->
      <time datetime={post.pubDate.toISOString()} class="flex items-center gap-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-4 h-4"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"
          ></path>
        </svg>
        {formatDate(post.pubDate)}
      </time>

      <!-- Autor -->
      {
        post.author && (
          <span class="flex items-center gap-1">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
              />
            </svg>
            {post.author}
          </span>
        )
      }
    </div>

    <!-- Título del post -->
    <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-3 group-hover:text-[rgb(var(--color-primary))] transition-colors duration-200">
      <a
        href={postUrl}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
        class="hover:underline"
      >
        {post.title}
        {
          isExternal && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-4 h-4 inline ml-1"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
              />
            </svg>
          )
        }
      </a>
    </h3>

    <!-- Excerpt/descripción -->
    <p class="text-gray-600 mb-4 leading-relaxed">
      {generateExcerpt(post.excerpt || post.description)}
    </p>

    <!-- Tags -->
    {
      post.tags && post.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {post.tags.slice(0, 3).map((tag) => (
            <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">
              #{tag}
            </span>
          ))}
        </div>
      )
    }

    <!-- Call to action -->
    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
      <a
        href={postUrl}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
        class="inline-flex items-center gap-2 text-[rgb(var(--color-primary))] font-semibold hover:gap-3 transition-all duration-200 group"
      >
        Leer más
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-5 h-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
        </svg>
      </a>

      <!-- Indicador de enlace externo -->
      {
        isExternal && (
          <span class="text-xs text-gray-500 flex items-center gap-1">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"
              />
            </svg>
            Enlace externo
          </span>
        )
      }
    </div>
  </div>
</article>

<style>
  .wordpress-post-card {
    position: relative;
  }

  /* Animación de hover más suave */
  .wordpress-post-card:hover {
    transform: translateY(-4px);
  }

  /* Badge gradient para WordPress */
  .badge-gradient-primary {
    background: linear-gradient(
      135deg,
      rgb(var(--color-primary)) 0%,
      rgb(var(--color-secondary)) 100%
    );
  }
</style>
